generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- AUTH MODELS (Required for NextAuth) ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(BUYER)
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  purchases     Purchase[]
  products      Product[]   // If they are also a seller
  buyerChats    ChatThread[] @relation("buyerChats")
  sellerChats   ChatThread[] @relation("sellerChats")
  chatMessages  ChatMessage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
}

// --- MARKETPLACE MODELS ---

model Product {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  price       Float
  category    String
  image       String
  version     String   @default("1.0.0")
  rating      Float    @default(5.0)
  createdAt   DateTime @default(now())
  
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id])
  purchases   Purchase[]
  chatThreads ChatThread[]
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  pricePaid   Float
  licenseKey  String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model ChatThread {
  id        String      @id @default(cuid())
  buyerId   String
  sellerId  String
  productId String
  status    ChatStatus  @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  buyer     User        @relation("buyerChats", fields: [buyerId], references: [id])
  seller    User        @relation("sellerChats", fields: [sellerId], references: [id])
  product   Product     @relation(fields: [productId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  thread    ChatThread @relation(fields: [threadId], references: [id])
  sender    User       @relation(fields: [senderId], references: [id])
}

enum ChatStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}